{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Pages で静的サイトを配信する
  // 本番: https://kaishi-lab.pages.dev（のちに lab.kaishi.ac.jp を Pages のカスタムドメインに設定）
  // プレビュー: https://<ブランチ名>.kaishi-lab.pages.dev
  "name": "kaishi-lab",
  "compatibility_date": "2026-09-01",
  "pages_build_output_dir": "./dist"
}
