---
// トップの hero: 先生をひとりずつ主役にして左右にローテーションする
// PC は左右、スマホは上下にスライドして切り替わる。自動で 6 秒ごとに次へ（操作中・動きを減らす設定では止まる）
// 横スワイプでも切り替えられる。高さは表示中の先生に合わせる
import type { Teacher } from '../lib/teachers';
import { href } from '../lib/teachers';
import { CLUSTERS } from '../lib/taxonomy';

interface Props {
  teachers: Teacher[];
}
const { teachers } = Astro.props;
---

<section class="carousel" aria-roledescription="carousel" aria-label="先生たち">
  <div class="car-track" id="car-track">
    {
      teachers.map((t, i) => (
        <article class="car-slide" aria-roledescription="slide" aria-label={`${i + 1} / ${teachers.length}: ${t.official.name}`}>
          <a class="car-card glass" href={href(`/${t.slug}/`)}>
            <div class="car-photo-wrap">
              <img class="car-photo" src={t.photo} alt="" loading={i < 2 ? 'eager' : 'lazy'} />
            </div>
            <div class="car-text">
              <p class="eyebrow">{t.official.title}</p>
              <h2 class="car-name">{t.official.name}</h2>
              <p class="car-en">{t.official.nameEn}</p>
              {t.headline && <p class="car-headline">{t.headline}</p>}
              <ul class="chips">
                {(t.data.clusters ?? []).map((c) => (
                  <li class="chip cluster">{CLUSTERS[c].label}</li>
                ))}
                {t.specialty.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
              {t.courses.length > 0 && (
                <ul class="chips course-tags">
                  {t.courses.slice(0, 4).map((c) => (
                    <li class="chip ctag">{c.name}</li>
                  ))}
                  {t.courses.length > 4 && <li class="chip outline">ほか{t.courses.length - 4}科目</li>}
                </ul>
              )}
              <span class="btn primary car-cta">この先生と学べること →</span>
            </div>
          </a>
        </article>
      ))
    }
  </div>
  <div class="car-controls">
    <button type="button" class="car-btn" id="car-prev" aria-label="前の先生"><span class="h">←</span><span class="v">↑</span></button>
    <span class="car-count" aria-live="polite"><span id="car-i">1</span> / {teachers.length}</span>
    <button type="button" class="car-btn" id="car-next" aria-label="次の先生"><span class="h">→</span><span class="v">↓</span></button>
  </div>
</section>

<script>
  const track = document.getElementById('car-track')!;
  const slides = [...track.querySelectorAll<HTMLElement>('.car-slide')];
  const label = document.getElementById('car-i')!;
  const n = slides.length;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let i = -1;
  let timer: number | undefined;

  const fit = () => (track.style.height = `${slides[i].offsetHeight}px`);
  const go = (k: number) => {
    const next = (k + n) % n;
    const back = i >= 0 && (k < i || (i === 0 && k === -1)) && !(i === n - 1 && next === 0);
    slides.forEach((s, j) => {
      s.classList.toggle('is-active', j === next);
      s.classList.toggle('is-leaving', j === i && i !== next);
      s.classList.toggle('back', back);
      s.inert = j !== next;
    });
    i = next;
    label.textContent = String(i + 1);
    fit();
  };
  // 写真・フォントの読み込みや画面幅の変化で高さが変わったら合わせ直す
  const ro = new ResizeObserver(() => i >= 0 && fit());
  slides.forEach((s) => ro.observe(s));
  document.getElementById('car-prev')!.addEventListener('click', () => (go(i - 1), start()));
  document.getElementById('car-next')!.addEventListener('click', () => (go(i + 1), start()));

  // 横スワイプ
  let x0: number | null = null;
  track.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  track.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) (go(i + (dx < 0 ? 1 : -1)), start());
    x0 = null;
  });

  const stop = () => clearInterval(timer);
  const start = () => {
    stop();
    if (!reduce) timer = window.setInterval(() => go(i + 1), 6000);
  };
  const root = track.parentElement!;
  root.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && stop());
  root.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && start());
  root.addEventListener('focusin', stop);
  root.addEventListener('focusout', start);
  document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

  // 毎回ちがう先生から始める（全員が平等に主役になるように）
  go(Math.floor(Math.random() * n));
  start();
</script>
