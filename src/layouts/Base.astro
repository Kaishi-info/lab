---
import '../styles/global.css';
import { REPO, href } from '../lib/teachers';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 横幅を広く使うページ（オフィスアワーの時間割など） */
  wide?: boolean;
}
const { title, description = '開志創造大学 情報デザイン学部の先生たちが、自分で書いて更新している教員ページです。', image, wide } = Astro.props;
const siteName = 'TEACHERS — 情報デザイン学部';
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} | 開志創造大学`;
const path = Astro.url.pathname;
const nav = [
  ['/', '先生'],
  ['/fields/', '分野'],
  ['/courses/', '授業'],
  ['/office-hours/', 'オフィスアワー'],
  ['/ask/', '質問'],
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4f6bff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <slot name="head" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Space+Grotesk:wght@500;600&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
    />
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <div class="orb o1"></div>
      <div class="orb o2"></div>
      <div class="orb o3"></div>
      <div class="orb o4"></div>
    </div>

    <header class="site-header">
      <div class:list={['wrap', { wide }]}>
        <div class="header-inner glass">
          <a class="brand" href={href('/')}>
            <img class="brand-mark" src={href('/logo-mark.svg')} alt="" width="26" height="30" />
            <span class="brand-text">
              <span class="brand-sub">開志創造大学 情報デザイン学部</span>
              <span class="brand-main">TEACHERS</span>
            </span>
          </a>
          <nav class="site-nav" aria-label="メイン">
            {nav.map(([p, label]) => (
              <a href={href(p)} aria-current={path === href(p) ? 'page' : undefined}>{label}</a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <main class:list={['wrap', { wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="glass">
          <p>
            このサイトは先生たち自身が <a href={REPO}>GitHub</a> で編集しています。
            公式の教員紹介は <a href="https://kaishi.ac.jp/info-d/teacher/">大学公式サイト</a> へ。
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
